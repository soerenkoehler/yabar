{
  "name": "swa-api",
  "version": "1.0.0",
  "description": "Azure Static Web Apps Managed Function API",
  "main": "functions/*.js",
  "scripts": {
    "prebuild": "TIMESTAMP=$(date +%Y%m%d_%H%M%S) envsubst <./functions/version.template.js >./functions/version.generated.js",
    "build": "npm install"
  },
  "dependencies": {
    "@azure/functions": "^4.0.0",
    "@azure/storage-queue": "~12.28.0",
    "google-auth-library": "^10.0.0"
  }
}
