{
    "name": "yabar-cloudflare",
    "version": "1.0.0",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "wrangler dev --var \"BUILD_TIMESTAMP:local:$(date +%Y%m%d_%H%M%S)\"",
        "deploy": "wrangler deploy",
        "d1:migrations:local": "wrangler d1 migrations apply DB --local",
        "d1:migrations:remote": "wrangler d1 migrations apply DB --remote"
    },
    "devDependencies": {
        "wrangler": "^4.0.0"
    }
}