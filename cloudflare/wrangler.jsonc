{
  "name": "yabar",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-22",
  "vars": {
    "BUILD_TIMESTAMP": "local",
    "CONFIG": {
      "expirationOptions": [
        { "value": "PT1M", "label": "1min", "allowOneClick": true },
        { "value": "PT5M", "label": "5min", "allowOneClick": true },
        { "value": "PT15M", "label": "15min", "allowOneClick": false },
        { "value": "PT1H", "label": "1 Hour", "allowOneClick": false },
        { "value": "P1D", "label": "1 Day", "allowOneClick": false },
        { "value": "P1W", "label": "1 Week", "allowOneClick": false }
      ]
    }
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yabar",
      "database_id": "__CLOUDFLARE_D1_DATABASE_ID__",
      "migrations_dir": "./d1/migrations"
    }
  ]
}